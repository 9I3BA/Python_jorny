class AuthWindow(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Фитнес-клуб: Вход")
        self.setFixedSize(350, 180)

        layout = QVBoxLayout()
        self.setLayout(layout)

        layout.addWidget(QLabel("Вход в систему", alignment=Qt.AlignmentFlag.AlignCenter))
        self.login_edit = QLineEdit()
        self.login_edit.setPlaceholderText("Логин")
        self.pass_edit = QLineEdit()
        self.pass_edit.setPlaceholderText("Пароль")
        self.pass_edit.setEchoMode(QLineEdit.EchoMode.Password)

        btn = QPushButton("Войти")
        btn.clicked.connect(self.login)

        layout.addWidget(self.login_edit)
        layout.addWidget(self.pass_edit)
        layout.addWidget(btn)

    def login(self):
        login = self.login_edit.text().strip()
        pwd = self.pass_edit.text()
        if not login or not pwd:
            QMessageBox.warning(self, "Ошибка", "Заполните все поля.")
            return

        res = db_query("SELECT userID, fio, userType FROM Users WHERE login = %s AND password = %s", (login, pwd), fetch=True)
        if res:
            uid, fio, role = res[0]
            self.hide()
            if role == "Администратор":
                self.w = AdminWindow(uid, fio)
            elif role == "Клиент":
                self.w = ClientWindow(uid, fio)
            elif role == "Тренер":
                self.w = TrainerWindow(uid, fio)
            elif role == "Директор":
                self.w = AdminWindow(uid, fio, is_director=True)
            self.w.show()
        else:
            QMessageBox.warning(self, "Ошибка", "Неверный логин или пароль.")

