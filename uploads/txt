def get_db_connection():
    return pymysql.connect(
        host='localhost',          # ← изменить, если сервер не локальный
        port=3306,
        user='root',               # ← ваш MySQL-логин
        password='password',       # ← ваш MySQL-пароль
        database='fitness',        # ← имя БД, созданной в Workbench
        charset='utf8mb4',
        autocommit=False
    )

def db_query(query, params=(), fetch=False):
    conn = get_db_connection()
    cursor = conn.cursor()
    try:
        cursor.execute(query, params)
        if fetch:
            return cursor.fetchall()
        else:
            conn.commit()
    finally:
        cursor.close()
        conn.close()

def get_active_membership(client_id):
    return db_query('''
        SELECT membershipID, visitsTotal, visitsUsed, endDate, zones
        FROM Memberships
        WHERE clientID = %s AND membershipStatus = 'Активен'
          AND endDate >= %s
    ''', (client_id, str(date.today())), fetch=True)

