        self.memberships_table.setRowCount(len(data))
        for i, row in enumerate(data):
            for j, val in enumerate(row):
                self.memberships_table.setItem(i, j, QTableWidgetItem(str(val)))

    def _open_sell_membership_dialog(self):
        dialog = SellMembershipDialog(self.user_id)
        if dialog.exec():
            cid, mtype, start, end, total, zones, cost = dialog.get_data()
            db_query('''
                INSERT INTO Memberships (clientID, membershipType, startDate, endDate,
                                         visitsTotal, visitsUsed, zones, membershipStatus, cost, adminID)
                VALUES (%s, %s, %s, %s, %s, 0, %s, 'Активен', %s, %s)
            ''', (cid, mtype, start, end, total, zones, cost, self.user_id))
            self._load_memberships()
            QMessageBox.information(self, "Успех", "Абонемент продан.")

    def _create_visits_tab(self):
        widget = QWidget()
        layout = QVBoxLayout()
        widget.setLayout(layout)

        self.visits_table = QTableWidget()
        self.visits_table.setColumnCount(7)
        self.visits_table.setHorizontalHeaderLabels(
            ["ID", "Клиент", "Дата", "Вход", "Выход", "Зона", "Абонемент"])
        self.visits_table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.ResizeToContents)
        layout.addWidget(self.visits_table)

        btn_add = QPushButton("Зафиксировать посещение")
        btn_add.clicked.connect(self._open_add_visit_dialog)
        layout.addWidget(btn_add)

        self._load_visits()
        return widget

    def _load_visits(self):
        data = db_query('''
            SELECT v.visitID, u.fio, v.visitDate, v.checkInTime, v.checkOutTime, v.zone, v.membershipID
            FROM Visits v
            JOIN Users u ON v.clientID = u.userID
            ORDER BY v.visitDate DESC, v.checkInTime DESC
        ''', fetch=True)
        self.visits_table.setRowCount(len(data))
        for i, row in enumerate(data):
            for j, val in enumerate(row):
                self.visits_table.setItem(i, j, QTableWidgetItem(str(val)))

    def _open_add_visit_dialog(self):
        dialog = AddVisitDialog()
        if dialog.exec():
            cid, zone, mid = dialog.get_data()
            memberships = get_active_membership(cid)
            if not memberships:
                QMessageBox.warning(self, "Ошибка", "У клиента нет активного абонемента.")
                return
            m = memberships[0]
            mid_check, total, used, end_date, zones = m
            if mid != mid_check:
                QMessageBox.warning(self, "Ошибка", "Указанный абонемент не активен или не принадлежит клиенту.")
                return
            if str(zone) not in str(zones).split(','):
                QMessageBox.warning(self, "Ошибка", f"Зона '{zone}' не входит в абонемент.")
                return
            if total != 999 and used >= total:
                QMessageBox.warning(self, "Ошибка", "Исчерпан лимит посещений.")
                return

            now = datetime.now()
            today = now.strftime('%Y-%m-%d')
            time_str = now.strftime('%H:%M')

            db_query("UPDATE Memberships SET visitsUsed = visitsUsed + 1 WHERE membershipID = %s", (mid,))
            db_query('''
                INSERT INTO Visits (clientID, visitDate, checkInTime, zone, membershipID)
                VALUES (%s, %s, %s, %s, %s)
            ''', (cid, today, time_str, zone, mid))

            self._load_visits()
            QMessageBox.information(self, "Успех", "Посещение зафиксировано.")

