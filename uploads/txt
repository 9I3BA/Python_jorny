class AddVisitDialog(QDialog):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Фиксация посещения")
        self.setMinimumWidth(400)
        layout = QFormLayout()
        self.setLayout(layout)

        clients = db_query("SELECT userID, fio FROM Users WHERE userType = 'Клиент'", fetch=True)
        self.client_combo = QComboBox()
        for uid, fio in clients:
            self.client_combo.addItem(f"{fio} (ID: {uid})", uid)
        layout.addRow("Клиент:", self.client_combo)

        self.zone = QComboBox()
        self.zone.addItems(["Тренажерный зал", "Бассейн", "Групповое занятие", "Спа"])

        self.membership_combo = QComboBox()
        self.client_combo.currentIndexChanged.connect(self._update_memberships)
        self._update_memberships()

        layout.addRow("Зона:", self.zone)
        layout.addRow("Абонемент:", self.membership_combo)

        btns = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        btns.accepted.connect(self.accept)
        btns.rejected.connect(self.reject)
        layout.addWidget(btns)

    def _update_memberships(self):
        self.membership_combo.clear()
        cid = self.client_combo.currentData()
        if cid is None:
            return
        memberships = db_query('''
            SELECT membershipID, membershipType, visitsTotal - visitsUsed AS remaining
            FROM Memberships
            WHERE clientID = %s AND membershipStatus = 'Активен'
        ''', (cid,), fetch=True)
        for mid, mtype, rem in memberships:
            label = f"{mtype} (осталось: {rem if rem != 999 else '∞'})"
            self.membership_combo.addItem(label, mid)

    def get_data(self):
        cid = self.client_combo.currentData()
        zone = self.zone.currentText()
        mid = self.membership_combo.currentData()
        return cid, zone, mid

