        layout.addWidget(tabs)

        tabs.addTab(self._create_memberships_tab(), "Мои абонементы")
        tabs.addTab(self._create_classes_tab(), "Групповые занятия")

    def _create_memberships_tab(self):
        widget = QWidget()
        layout = QVBoxLayout()
        widget.setLayout(layout)

        table = QTableWidget()
        table.setColumnCount(7)
        table.setHorizontalHeaderLabels(["ID", "Тип", "Начало", "Конец", "Всего", "Исп.", "Статус"])
        table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.Stretch)
        layout.addWidget(table)

        memberships = db_query('''
            SELECT membershipID, membershipType, startDate, endDate, visitsTotal, visitsUsed, membershipStatus
            FROM Memberships WHERE clientID = %s
        ''', (self.user_id,), fetch=True)

        table.setRowCount(len(memberships))
        for i, m in enumerate(memberships):
            for j, val in enumerate(m):
                table.setItem(i, j, QTableWidgetItem(str(val)))

        return widget

    def _create_classes_tab(self):
        widget = QWidget()
        layout = QVBoxLayout()
        widget.setLayout(layout)

        self.classes_table = QTableWidget()
        self.classes_table.setColumnCount(8)
        self.classes_table.setHorizontalHeaderLabels(
            ["ID", "Название", "Тренер", "Дата", "Время", "Зал", "Мест", "Статус"])
        self.classes_table.horizontalHeader().setSectionResizeMode(QHeaderView.ResizeMode.ResizeToContents)
        layout.addWidget(self.classes_table)

        btn_enroll = QPushButton("Записаться на занятие")
        btn_enroll.clicked.connect(self._enroll_to_class)
        layout.addWidget(btn_enroll)

        self._load_classes()
        return widget

    def _load_classes(self):
        data = db_query('''
            SELECT gc.classID, gc.className, u.fio, gc.classDate, gc.startTime, gc.hall,
                   gc.enrolledParticipants, gc.maxParticipants, gc.classStatus
            FROM GroupClasses gc
            JOIN Users u ON gc.trainerID = u.userID
            WHERE gc.classDate >= %s AND gc.classStatus IN ('Запланировано', 'Группа заполнена')
        ''', (str(date.today()),), fetch=True)

        self.classes_table.setRowCount(len(data))
        for i, c in enumerate(data):
            cid, name, tr, d, t, h, en, mx, st = c
            status = f"{st} ({en}/{mx})"
            self.classes_table.setItem(i, 0, QTableWidgetItem(str(cid)))
            self.classes_table.setItem(i, 1, QTableWidgetItem(name))
            self.classes_table.setItem(i, 2, QTableWidgetItem(tr))
            self.classes_table.setItem(i, 3, QTableWidgetItem(d))
            self.classes_table.setItem(i, 4, QTableWidgetItem(f"{t}"))
            self.classes_table.setItem(i, 5, QTableWidgetItem(h))
            self.classes_table.setItem(i, 6, QTableWidgetItem(f"{en}/{mx}"))
            self.classes_table.setItem(i, 7, QTableWidgetItem(st))

    def _enroll_to_class(self):
        row = self.classes_table.currentRow()
        if row == -1:
            QMessageBox.warning(self, "Ошибка", "Выберите занятие.")
            return

        cid = int(self.classes_table.item(row, 0).text())
        status = self.classes_table.item(row, 7).text()
        enrolled = int(self.classes_table.item(row, 6).text().split('/')[0])
        max_p = int(self.classes_table.item(row, 6).text().split('/')[1])

        if status == "Группа заполнена":
            QMessageBox.warning(self, "Ошибка", "Группа уже заполнена.")
            return

        memberships = get_active_membership(self.user_id)
        valid = any("Групповые" in m[4] for m in memberships)
        if not valid:
            QMessageBox.warning(self, "Ошибка", "Нет активного абонемента с доступом к групповым занятиям.")
            return

        db_query("UPDATE GroupClasses SET enrolledParticipants = enrolledParticipants + 1 WHERE classID = %s", (cid,))
        if enrolled + 1 >= max_p:
            db_query("UPDATE GroupClasses SET classStatus = 'Группа заполнена' WHERE classID = %s", (cid,))

        self._load_classes()
        QMessageBox.information(self, "Успех", "Вы записаны на занятие!")

