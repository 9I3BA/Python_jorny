class ClientWindow(QMainWindow):
    def __init__(self, user_id, fio):
        super().__init__()
        self.user_id = user_id
        self.fio = fio
        self.setWindowTitle(f"Клиент: {fio}")
        self.resize(800, 500)

        central = QWidget()
